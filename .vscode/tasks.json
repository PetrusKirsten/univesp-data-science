{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build C++ (MSYS2 UCRT64)",
      "type": "shell",
      "command": "g++",
      "args": [
        "-std=c++20",
        "-O2",
        "-Wall",
        "-Wextra",
        "-pedantic",
        "*.cpp",
        "-o",
        "app.exe"
      ],
      "problemMatcher": ["$gcc"],
      "group": { "kind": "build", "isDefault": true }
    }
  ]
}